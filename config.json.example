{
    "telegram": {
        "bot_token": "YOUR_BOT_TOKEN_HERE",
        "chat_id": "-100123456789",
        "topics": {
            "backup_requests": 1,
            "size_ask": 2,
            "execution_errors": 3,
            "admin": 4
        }
    },
    "mongodb": {
        "uri": "mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
    },
    "redis": {
        "url": "redis://localhost:6379/0"
    },
    "database": {
        "url": "sqlite+aiosqlite:///./mongo_ops.db"
    },
    "backup": {
        "base_path": "./backups",
        "retention": {
            "full_weeks": 4,
            "custom_weeks": 2,
            "max_gb": 50
        }
    },
    "logging": {
        "level": "INFO"
    },
    "concurrency": {
        "max_concurrent_backups": 3
    }
}
